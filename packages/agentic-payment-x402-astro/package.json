{
  "name": "agentic-payment-x402-astro",
  "version": "0.1.0",
  "description": "Agentic Pay for Astro — x402 payment gateway, HTTP 402 middleware for AI agents, and reactive wallet checkout components.",
  "keywords": [
    "astro",
    "astro-integration",
    "x402",
    "crypto",
    "usdc",
    "base",
    "payments",
    "agentic-commerce",
    "ai-agents"
  ],
  "author": "AIOpsome (https://aiopsome.com)",
  "license": "MIT",
  "homepage": "https://github.com/AIOpsome/agentic-payment-x402-astro/tree/main/packages/agentic-payment-x402-astro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIOpsome/agentic-payment-x402-astro.git",
    "directory": "packages/agentic-payment-x402-astro"
  },
  "bugs": {
    "url": "https://github.com/AIOpsome/agentic-payment-x402-astro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    },
    "./endpoints": {
      "types": "./dist/endpoints.d.ts",
      "import": "./dist/endpoints.mjs",
      "require": "./dist/endpoints.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./components/AgenticPayButton.astro": "./src/components/AgenticPayButton.astro",
    "./components/WalletCheckout.astro": "./src/components/WalletCheckout.astro"
  },
  "files": [
    "dist",
    "src/components",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agentic-payment-x402-core": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "astro": "^5.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
