{
  "name": "agentic-payment-x402-core",
  "version": "0.2.0",
  "description": "Universal TypeScript/JavaScript core engine for x402 stablecoin payments across client wallets and server facilitators.",
  "keywords": [
    "x402",
    "crypto",
    "usdc",
    "base",
    "ethereum",
    "eip3009",
    "eip712",
    "payments",
    "agentic-commerce",
    "ai-agents"
  ],
  "author": "AIOpsome (https://aiopsome.com)",
  "license": "MIT",
  "homepage": "https://github.com/AIOpsome/agentic-payment-x402-astro/tree/main/packages/agentic-payment-x402-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIOpsome/agentic-payment-x402-astro.git",
    "directory": "packages/agentic-payment-x402-core"
  },
  "bugs": {
    "url": "https://github.com/AIOpsome/agentic-payment-x402-astro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
